# Example Environment Variables
# Copy this file to .env.local and update the values

# Environment type: mock, development, uat, production, dr
NEXT_PUBLIC_CO_DEV_ENV=mock

# User Info API URL - for top header panel user info
NEXT_PUBLIC_USER_INFO_API_URL=http://localhost:3000/api

# Exception Data API URL - for exception data, commentary, file upload etc
NEXT_PUBLIC_EXCEPTION_API_URL=http://localhost:3001/api

# BAM Authentication API URL - for authentication
NEXT_PUBLIC_BAM_AUTH_API_URL=http://localhost:3002/api

# Avatar service URL for user profile pictures
NEXT_PUBLIC_AVATAR_URL=https://api.dicebear.com/7.x/initials/svg